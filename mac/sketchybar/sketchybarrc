#!/bin/bash

# SRE Zen Sketchybar Config (Tokyonight)
# Inspired by Polybar setup

# Colors
export BG=0xff011628
export BG_ALT=0xff143652
export FG=0xffCBE0F0
export ACCENT=0xff7aa2f7
export MAGENTA=0xffbb9af7
export RED=0xfff7768e

# General Settings
sketchybar --bar \
    height=32 \
    color=$BG \
    shadow=off \
    position=top \
    sticky=on \
    padding_left=10 \
    padding_right=10 \
    corner_radius=6 \
    font="JetBrains Mono:12.0"

# Left: Workspaces (Spaces)
sketchybar --add space space.1 left --set space.1 label="1" associated_space=1
sketchybar --add space space.2 left --set space.2 label="2" associated_space=2
sketchybar --add space space.3 left --set space.3 label="3" associated_space=3
sketchybar --add space space.4 left --set space.4 label="4" associated_space=4
sketchybar --add space space.5 left --set space.5 label="5" associated_space=5

sketchybar --default \
    padding_left=5 \
    padding_right=5 \
    icon.font="JetBrains Mono:Bold:14.0" \
    label.font="JetBrains Mono:Regular:12.0" \
    label.color=$FG \
    icon.color=$ACCENT

# Right: SRE Metrics
sketchybar --add item clock right \
    --set clock update_freq=10 icon="󱑒" label.color=$MAGENTA script="date '+%H:%M'"

sketchybar --add item cpu right \
    --set cpu update_freq=2 icon="󰻠" label="CPU" script="top -l 1 | grep -E \"^CPU\" | awk '{print \$3}'"

sketchybar --add item battery right \
    --set battery update_freq=60 icon="󰁹" script="pmset -g batt | grep -Eo '[0-9]+%' | head -1"

# Event handling
sketchybar --add event window_focus
sketchybar --add item window_title center \
    --subscribe window_title window_focus \
    --set window_title label.color=$FG label="SRE Workstation"

sketchybar --update
echo "sketchybar configuration loaded.."
